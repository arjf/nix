#!/usr/bin/env bash
FLAKE="/home/jo/clones/nix"
SYS="nixy"
CMD="switch"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--system)
      SYS="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: nix-upd [options] [command]"
      echo "  -s, --system <name>  system to rebuild (default: nixy)"
      echo "  -h, --help           show this help"
      echo "  command              nixos-rebuild command (default: switch)"
      echo ""
      echo "Commands: switch, test, boot, dry-build, dry-activate, build"
      exit 0
      ;;
    *)
      CMD="$1"
      shift
      ;;
  esac
done

sudo nixos-rebuild "$CMD" --flake "$FLAKE#$SYS"
